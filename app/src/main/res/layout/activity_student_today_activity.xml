<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4935B8"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#4935B8"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back_symbol"
            app:tint="#FFFFFF"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today's Activity"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"/>

    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        android:background="#F5F6FC"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CURRENT DATE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/calendar_symbol"
                    app:tint="#4935B8"
                    android:contentDescription="Calendar"/>

                <TextView
                    android:id="@+id/tvCurrentDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Thursday, May 15, 2025"
                    android:textColor="#18233F"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- SUBMITTED ACTIVITY VIEW (Shown if already uploaded today) -->
            <LinearLayout
                android:id="@+id/layoutSubmittedView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:background="@drawable/card_green">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/check_circle_symbol"
                            app:tint="#10B23E"
                            android:contentDescription="Check"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Submitted Today"
                            android:textColor="#10B23E"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubmittedTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Submitted at 10:30 AM"
                        android:textColor="#68738A"
                        android:textSize="12sp"
                        android:gravity="end"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEF3"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uploaded Document"
                    android:textColor="#68738A"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvSubmittedFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="📄 assignment.pdf"
                    android:textColor="#18233F"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description / Notes"
                    android:textColor="#68738A"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvSubmittedNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="Completed Java loops activity assignment."
                    android:textColor="#18233F"
                    android:textSize="14sp"/>

                <!-- ACTION BUTTONS: EDIT & DELETE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEditSubmission"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Edit Activity"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="#4935B8"
                        app:cornerRadius="10dp"/>

                    <Button
                        android:id="@+id/btnDeleteSubmission"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Delete"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="#D94343"
                        app:cornerRadius="10dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- UPLOAD FORM LAYOUT (Shown for new/edit submissions) -->
            <LinearLayout
                android:id="@+id/layoutUploadForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- UPLOAD DOCUMENTS / IMAGES BOX SECTION -->
                <TextView
                    android:id="@+id/tvFormTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Upload Document / Image"
                    android:textColor="#18233F"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/layoutUploadBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/upload_box_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:id="@+id/imgUploadIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_upload"
                        app:tint="#4935B8"
                        android:contentDescription="Upload Icon"/>

                    <TextView
                        android:id="@+id/tvUploadTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Click here to upload file"
                        android:textColor="#18233F"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvUploadSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Supports images, PDF, Word &amp; documents"
                        android:textColor="#68738A"
                        android:textSize="12sp"
                        android:gravity="center"/>

                    <!-- SELECTED FILE PREVIEW CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutSelectedFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_green"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/check_circle_symbol"
                            app:tint="#10B23E"
                            android:contentDescription="Check"/>

                        <TextView
                            android:id="@+id/tvFileName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="document.pdf"
                            android:textColor="#10B23E"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- NOTES / DESCRIPTION SECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Notes / Description"
                    android:textColor="#18233F"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etActivityNotes"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/input_box"
                    android:gravity="top|start"
                    android:padding="14dp"
                    android:hint="Write notes or description about today's activity..."
                    android:textColor="#18233F"
                    android:textColorHint="#9299AA"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="24dp"/>

                <!-- SUBMIT BUTTON -->
                <Button
                    android:id="@+id/btnSubmitActivity"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="20dp"
                    android:text="Submit Activity"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="#4935B8"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
