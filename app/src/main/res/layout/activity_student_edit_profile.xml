<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4935B8"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#4935B8"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back_symbol"
            app:tint="#FFFFFF"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"/>

    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        android:background="#F5F6FC"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/action_card"
            android:elevation="2dp">

            <!-- NAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#26334D"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etStudentName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/input_box"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Arun Kumar"
                android:textColor="#18233F"
                android:textSize="14sp"
                android:inputType="textPersonName"/>

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#26334D"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etStudentEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/input_box"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="arun@college.edu"
                android:textColor="#18233F"
                android:textSize="14sp"
                android:inputType="textEmailAddress"/>

            <!-- PHONE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textColor="#26334D"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etStudentPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/input_box"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="98765 43210"
                android:textColor="#18233F"
                android:textSize="14sp"
                android:inputType="phone"/>

            <!-- UPDATE BUTTON -->
            <Button
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Update Profile"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#4935B8"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
