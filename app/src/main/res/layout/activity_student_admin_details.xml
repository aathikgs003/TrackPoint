<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4935B8"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#4935B8">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back_symbol"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Student Admin Details"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F5F6FC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Admin Profile Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:padding="14dp"
                    android:src="@drawable/profile_symbol"
                    app:tint="#4935B8"
                    android:background="@drawable/card_purple"
                    android:contentDescription="Profile Icon" />

                <TextView
                    android:id="@+id/txtAdminName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#18233F"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/txtAdminId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin ID"
                    android:textSize="13sp"
                    android:textColor="#68738A"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Info Rows Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:padding="18dp"
                android:layout_marginBottom="18dp">

                <!-- Department -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_department"
                        app:tint="#4935B8"
                        android:contentDescription="Department Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Department"
                        android:paddingStart="10dp"
                        android:textSize="13sp"
                        android:textColor="#68738A" />

                    <TextView
                        android:id="@+id/txtAdminDepartment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CSE"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#18233F" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEF3" android:layout_marginVertical="4dp"/>

                <!-- Year -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_academic_year"
                        app:tint="#4935B8"
                        android:contentDescription="Year Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Year"
                        android:paddingStart="10dp"
                        android:textSize="13sp"
                        android:textColor="#68738A" />

                    <TextView
                        android:id="@+id/txtAdminYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="III Year"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#18233F" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEF3" android:layout_marginVertical="4dp"/>

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_phone"
                        app:tint="#4935B8"
                        android:contentDescription="Phone Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phone"
                        android:paddingStart="10dp"
                        android:textSize="13sp"
                        android:textColor="#68738A" />

                    <TextView
                        android:id="@+id/txtAdminPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="98765 43201"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#18233F" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEF3" android:layout_marginVertical="4dp"/>

                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_email"
                        app:tint="#4935B8"
                        android:contentDescription="Email Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Email"
                        android:paddingStart="10dp"
                        android:textSize="13sp"
                        android:textColor="#68738A" />

                    <TextView
                        android:id="@+id/txtAdminEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="arun@college.edu"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#18233F" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEF3" android:layout_marginVertical="4dp"/>

                <!-- Students Assigned -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/group_symbol"
                        app:tint="#4935B8"
                        android:contentDescription="Students Assigned Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Students Assigned"
                        android:paddingStart="10dp"
                        android:textSize="13sp"
                        android:textColor="#68738A" />

                    <TextView
                        android:id="@+id/txtStudentsAssigned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#18233F" />
                </LinearLayout>

            </LinearLayout>

            <!-- View Students Button -->
            <Button
                android:id="@+id/btnViewStudents"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="View Students"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#4935B8"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

            <!-- Attendance Button -->
            <Button
                android:id="@+id/btnAttendance"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Attendance Report"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#4935B8"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

            <!-- Daily Progress Button -->
            <Button
                android:id="@+id/btnProgress"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Daily Progress"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#4935B8"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
