<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF"
    android:padding="18dp">

    <!-- Sidebar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#4935B8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TrackPoint"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Student Admin"
            android:textColor="#DDD8FF"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Menu Items -->
    <TextView
        android:id="@+id/menuDashboard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="⌂     Dashboard"
        android:textColor="#34415B"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuStudents"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="👥     My Students"
        android:textColor="#34415B"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuProgress"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="📝     Daily Progress"
        android:textColor="#34415B"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuAttendance"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="☑     Attendance"
        android:textColor="#34415B"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuReports"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="📄     Reports"
        android:textColor="#34415B"
        android:textSize="15sp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#EEEEF3"/>

    <TextView
        android:id="@+id/menuProfile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="👤     My Profile"
        android:textColor="#34415B"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/menuNotifications"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="🔔     Notifications"
        android:textColor="#34415B"
        android:textSize="15sp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEF3"/>

    <TextView
        android:id="@+id/menuLogout"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="↪     Logout"
        android:textColor="#D94343"
        android:textSize="15sp"
        android:textStyle="bold"/>

</LinearLayout>
