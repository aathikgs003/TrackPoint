<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4935B8"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#4935B8">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back_symbol"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Submission Details"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/btnHeaderDownload"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_download"
            app:tint="@color/white"
            android:contentDescription="Download" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F5F6FC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Student Info Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="10dp"
                    android:src="@drawable/profile_symbol"
                    app:tint="#4935B8"
                    android:background="@drawable/card_purple"
                    android:contentDescription="Student Avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/txtSubStudentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#18233F" />

                    <TextView
                        android:id="@+id/txtSubRegDept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#68738A" />
                </LinearLayout>

            </LinearLayout>

            <!-- Metadata Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_purple"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assigned Student Admin"
                        android:textSize="11sp"
                        android:textColor="#68738A" />

                    <TextView
                        android:id="@+id/txtSubAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#4935B8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Submitted On"
                        android:textSize="11sp"
                        android:textColor="#68738A" />

                    <TextView
                        android:id="@+id/txtSubDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#18233F" />
                </LinearLayout>

            </LinearLayout>

            <!-- Daily Notes Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progress Summary / Daily Notes"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#18233F"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtSubNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:padding="14dp"
                android:textSize="14sp"
                android:textColor="#18233F"
                android:layout_marginBottom="16dp" />

            <!-- Uploaded Attachment Card -->
            <TextView
                android:id="@+id/txtAttachmentHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded Attachment"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#18233F"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/cardAttachment"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtFileBadge"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="PDF"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="#D32F2F" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/txtFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#18233F" />

                    <TextView
                        android:id="@+id/txtFileSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#4935B8" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#68738A" />

            </LinearLayout>

            <!-- Staff Remarks -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff Notes / Remarks (Optional)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#18233F"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtStaffRemark"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="top|start"
                android:hint="Type remarks here..."
                android:textColor="#18233F"
                android:textColorHint="#9299AA"
                android:padding="12dp"
                android:background="@drawable/input_box"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSaveRemark"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save Remark"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#4935B8"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
