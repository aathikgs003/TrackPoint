<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4935B8"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#4935B8">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back_symbol"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Staff Admin Details"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="28dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F5F6FC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Profile Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_purple"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:padding="12dp"
                    android:src="@drawable/profile_symbol"
                    app:tint="#4935B8"
                    android:background="#E2D5FF"
                    android:contentDescription="Staff Avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp">

                    <TextView
                        android:id="@+id/txtStaffName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prof. Ramesh K"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#18233F" />

                    <TextView
                        android:id="@+id/txtStaffId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="STF001"
                        android:textSize="13sp"
                        android:textColor="#4935B8"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Staff Admin"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4935B8"
                        android:background="#E2D5FF"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Action Icons (Edit & Delete) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnEditStaff"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:src="@drawable/edit_symbol"
                        app:tint="#4935B8"
                        android:background="@drawable/action_card"
                        android:elevation="1dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Edit Staff Admin"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/btnDeleteStaff"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_trash"
                        app:tint="#DC3545"
                        android:background="@drawable/action_card"
                        android:elevation="1dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Delete Staff Admin" />

                </LinearLayout>

            </LinearLayout>

            <!-- Profile Info Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:padding="18dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Department"
                    android:textSize="12sp"
                    android:textColor="#68738A" />

                <TextView
                    android:id="@+id/txtStaffDepartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CSE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#18233F"
                    android:layout_marginBottom="12dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEF3" android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textSize="12sp"
                    android:textColor="#68738A" />

                <TextView
                    android:id="@+id/txtStaffEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ramesh@college.edu"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#18233F"
                    android:layout_marginBottom="12dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEF3" android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textSize="12sp"
                    android:textColor="#68738A" />

                <TextView
                    android:id="@+id/txtStaffPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="98765 11101"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#18233F"
                    android:layout_marginBottom="12dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEF3" android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned Student Admins"
                    android:textSize="12sp"
                    android:textColor="#68738A" />

                <TextView
                    android:id="@+id/txtStaffStudentAdminCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 Student Admins"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#4935B8" />
            </LinearLayout>

            <!-- Action Button to View Assigned Student Admins -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewAssignedStudentAdmins"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="View Assigned Student Admins"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#4935B8"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>