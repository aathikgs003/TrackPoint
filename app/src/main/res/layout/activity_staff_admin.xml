<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4935B8"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#4935B8">

        <ImageView
            android:id="@+id/btnStaffMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/menu_symbol"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff Admin"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Academic Staff"
                android:textColor="#DDD8FF"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnStaffHeaderLogout"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/logout_symbol"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Logout" />

    </LinearLayout>

    <!-- Dashboard Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F5F6FC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome,\nStaff Admin 👋"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#18233F" />

            <TextView
                android:id="@+id/txtDashboardDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today, Jan 26, 2025"
                android:gravity="end"
                android:textSize="13sp"
                android:textColor="#68738A"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- First Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_purple"
                    android:elevation="2dp"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_staff_admins"
                        app:tint="#4935B8"
                        android:contentDescription="Student Admins" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Student Admins"
                            android:textColor="#34415B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStaffAdminsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#18233F" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_blue"
                    android:elevation="2dp"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_staff_students"
                        app:tint="#247AE3"
                        android:contentDescription="Students" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Students"
                            android:textColor="#34415B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStaffStudentsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#18233F" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Second Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_green"
                    android:elevation="2dp"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/attendance_symbol"
                        app:tint="#10B23E"
                        android:contentDescription="Attendance" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Attendance"
                            android:textColor="#34415B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStaffAttendanceRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#18233F" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_yellow"
                    android:elevation="2dp"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/reports_symbol"
                        app:tint="#D97706"
                        android:contentDescription="Submissions" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Submissions"
                            android:textColor="#34415B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStaffSubmissionsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#18233F" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Quick Access -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Access"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#18233F"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_staff_admins"
                    app:tint="#4935B8"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Student Admins Icon" />

                <TextView
                    android:id="@+id/quickAdmins"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Student Admins"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#18233F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="#68738A" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_staff_students"
                    app:tint="#4935B8"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Students Icon" />

                <TextView
                    android:id="@+id/quickStudents"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Students"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#18233F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="#68738A" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/action_card"
                android:elevation="2dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/daily_progress_symbol"
                    app:tint="#4935B8"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Progress History Icon" />

                <TextView
                    android:id="@+id/quickProgressHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Progress History"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#18233F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="24sp"
                    android:textColor="#68738A" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
