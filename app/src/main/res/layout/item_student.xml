<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/action_card"
    android:elevation="1dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/profile_symbol"
        app:tint="#4935B8"
        android:background="@drawable/card_purple"
        android:contentDescription="Student Profile"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textColor="#18233F"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvRollNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Roll Number"
            android:textColor="#68738A"
            android:textSize="12sp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnViewStudent"
        android:layout_width="65dp"
        android:layout_height="36dp"
        android:text="View"
        android:textColor="#4935B8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:backgroundTint="#EAE5FF"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:cornerRadius="8dp"/>

</LinearLayout>
